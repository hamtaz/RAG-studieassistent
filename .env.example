# Copy this file to .env and fill in real values. .env is gitignored.

# Azure Cosmos DB (NoSQL API) - COSMOS_URI required.
COSMOS_URI=https://<your-account>.documents.azure.com:443/

# COSMOS_KEY is optional. Set it to authenticate with the account's primary
# key. Leave it blank to authenticate via DefaultAzureCredential instead (az
# login locally, Managed Identity once deployed) - no secret stored, but
# needs a one-time RBAC role assignment on the account first, see
# CLAUDE.md's Environment section for the exact command.
COSMOS_KEY=

# Optional - defaults shown. The container must already exist with a
# vectorEmbeddingPolicy and matching vectorIndexes on /embedding; nothing in
# this codebase provisions it (see scripts/verify_cosmos_connection.py).
COSMOS_DATABASE_NAME=studieassistent
COSMOS_CONTAINER_NAME=chunk

# Azure OpenAI - required. Same resource, two deployments: one for
# embeddings, one for chat (e.g. gpt-4o-mini) used to generate answers.
AZURE_AI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_AI_KEY=
AZURE_AI_DEPLOYMENT_NAME=<your-embedding-deployment-name>
AZURE_AI_CHAT_DEPLOYMENT_NAME=<your-chat-deployment-name>
