# Copy this file to .env and fill in real values. .env is gitignored.

# Azure Cosmos DB (NoSQL API) - required.
# get_container() in src/cosmos_client.py raises without these two.
COSMOS_URI=https://<your-account>.documents.azure.com:443/
COSMOS_KEY=

# Optional - defaults shown. The container must already exist with a
# vectorEmbeddingPolicy and matching vectorIndexes on /embedding; nothing in
# this codebase provisions it (see scripts/verify_cosmos_connection.py).
COSMOS_DATABASE_NAME=studieassistent
COSMOS_CONTAINER_NAME=chunk

# Azure OpenAI embedding deployment - required.
AZURE_AI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_AI_KEY=
AZURE_AI_DEPLOYMENT_NAME=<your-embedding-deployment-name>
